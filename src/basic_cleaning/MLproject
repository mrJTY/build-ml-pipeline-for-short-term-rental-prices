name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: The input artifact that may have unclean data
        type: string

      output_artifact:
        description: The cleaned output artifact to be saved in wandb
        type: string

      output_type:
        description: The type or tag of an output. eg: cleaned_sample as opposed to raw_data, model_export.
        type: string

      output_description:
        description: The output description, eg: data with outliers removed and cleaned.
        type: string

      min_price:
        description: Minimum price that for rental prices.
        type: string

      max_price:
        description: Maximum price for the rental price.
        type: string


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
